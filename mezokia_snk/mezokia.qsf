set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FTXE
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FUSB_nRES
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FU_D[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FU_D[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FU_D[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FU_D[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FU_D[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FU_D[2]
